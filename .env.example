# rules: 本地规则演示; llm: LangChain 大模型结构化提取
EXTRACTOR=rules
# local: PDF文本层 + RapidOCR; remote: 题目指定OCR，所有PDF/图片必须调用接口
OCR_MODE=local
OCR_ENDPOINT=http://36.103.199.11:5002/process
# JSON: {"sha256或文件名": "OCR服务器可以访问的https下载地址"}
OCR_URL_MAP=
OCR_CONNECT_TIMEOUT=10
OCR_READ_TIMEOUT=300
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_STRUCTURED_METHOD=function_calling
LLM_TIMEOUT=90
MIN_CONFIDENCE=0.85
